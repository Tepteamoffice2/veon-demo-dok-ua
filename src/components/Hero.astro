---
// First screen: blue field, H1, the picker «прилад підбору» (plate · VIN 17 cells · make and model) and the expert call.
// Honest demo: the search itself is a FutureLink state; the real action next to it is the phone.
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { brands, phoneMain } from "../data/site";
const vinCells = Array.from({ length: 17 });
---
<section id="hero" class="hero on-brand" data-rec="R-001,R-005,R-006,R-101,R-106,R-109,G-R001,M-R005" aria-labelledby="hero-title">
  <div class="container hero__in">
    <h1 id="hero-title" class="hero__title">Автозапчастини для іномарок з&nbsp;підбором за&nbsp;VIN</h1>

    <div class="picker" data-picker data-rec="S-R004">
      <div class="tabs" role="tablist" aria-label="Спосіб підбору">
        <span class="tabs__ind" aria-hidden="true"></span>
        <button class="tabs__tab" role="tab" id="tab-plate" aria-selected="true" aria-controls="panel-plate" type="button">Держномер</button>
        <button class="tabs__tab" role="tab" id="tab-vin" aria-selected="false" aria-controls="panel-vin" tabindex="-1" type="button">VIN-код</button>
        <button class="tabs__tab" role="tab" id="tab-model" aria-selected="false" aria-controls="panel-model" tabindex="-1" type="button">Марка<span class="tab-more"> і модель</span></button>
      </div>

      <div class="picker__row">
        <div class="panels">
          <div class="panel" role="tabpanel" id="panel-plate" aria-labelledby="tab-plate">
            <label class="panel__label" for="plate-input">Держномер вашого авто</label>
            <div class="plate">
              <span class="plate__ua" aria-hidden="true"><span class="plate__flag"></span>UA</span>
              <input id="plate-input" class="plate__input mono" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="10" placeholder="Введіть номер" aria-describedby="plate-hint" data-plate />
            </div>
            <p id="plate-hint" class="panel__hint">Наприклад, AA 1234 BB</p>
          </div>

          <div class="panel" role="tabpanel" id="panel-vin" aria-labelledby="tab-vin">
            <div class="panel__top">
              <label class="panel__label" for="vin-input">VIN-код, 17 знаків</label>
              <span class="vin__count mono" aria-live="polite" data-vin-count>0 / 17</span>
            </div>
            <div class="vin">
              <span class="vin__cells" aria-hidden="true">{vinCells.map(() => <span class="vin__cell"></span>)}</span>
              <input id="vin-input" class="vin__input mono" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="17" aria-describedby="vin-hint" data-vin />
            </div>
            <p id="vin-hint" class="panel__hint">VIN є у свідоцтві про реєстрацію авто</p>
          </div>

          <div class="panel" role="tabpanel" id="panel-model" aria-labelledby="tab-model">
            <div class="selects">
              <div class="field">
                <label class="panel__label" for="make-select">Марка</label>
                <select id="make-select" class="select" data-make>
                  <option value="">Оберіть марку</option>
                  {brands.map((b) => <option value={b}>{b}</option>)}
                </select>
              </div>
              <div class="field">
                <label class="panel__label" for="model-select">Модель і рік</label>
                <select id="model-select" class="select" disabled aria-describedby="model-hint">
                  <option value="">Спершу марка</option>
                </select>
              </div>
            </div>
            <p id="model-hint" class="panel__hint" data-model-hint>Повний вибір моделі — у повній версії сайту</p>
          </div>
        </div>

        <div class="picker__go">
          <FutureLink as="button" class="btn btn--accent picker__find" note="Онлайн-підбір з’явиться в повній версії сайту">
            <Icon name="search" size={20} />Знайти запчастини
          </FutureLink>
        </div>
      </div>

      <div class="picker__alt">
        <a class="btn btn--ghost-light expert" href={phoneMain.href} data-rec="R-002">
          <Icon name="phone" size={20} />
          <span class="expert__text">Підбір за VIN з експертом <span class="mono expert__num">{phoneMain.label}</span></span>
        </a>
        <p class="hero__facts">У базі підбору — 38&nbsp;тис.+ модифікацій авто, у каталозі — 15&nbsp;млн товарів, повернення й обмін — до 365&nbsp;днів для більшості товарів.</p>
      </div>
    </div>
    <dl class="hero__aside" aria-label="dok.ua у цифрах">
      <div class="hero__fact"><dt class="hero__num">15 млн</dt><dd>товарів у каталозі</dd></div>
      <div class="hero__fact"><dt class="hero__num">38 тис.+</dt><dd>модифікацій авто в базі підбору</dd></div>
      <div class="hero__fact"><dt class="hero__num">до 365 днів</dt><dd>на повернення й обмін для більшості товарів</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero { padding-block: var(--s-5) var(--s-6); }
  .hero__in { display: grid; gap: var(--s-5); }
  .hero__title { font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: -0.03em; max-width: 25ch; color: var(--color-on-brand); }

  .picker { display: grid; gap: var(--s-4); max-width: 52rem; }
  .js .picker > * { animation: rise 450ms var(--ease-out) both; }
  .js .picker > :nth-child(2) { animation-delay: 40ms; }
  .js .picker > :nth-child(3) { animation-delay: 80ms; }
  @keyframes rise { from { opacity: .35; transform: translateY(8px); } }
  @media (max-width: 767px) { .js .picker > * { animation-delay: 0ms !important; } }

  /* tabs: segmented control, equal columns, a pill that slides (effect 2) */
  .tabs { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: var(--edge-w) solid var(--color-on-brand-2); border-radius: var(--radius); padding: var(--s-1); max-width: 34rem; }
  .tabs__ind { display: none; position: absolute; top: var(--s-1); bottom: var(--s-1); left: var(--s-1); width: calc((100% - 2 * var(--s-1)) / 3); background: var(--color-surface); border-radius: calc(var(--radius) - var(--s-1)); transform: translateX(calc(var(--i, 0) * 100%)); transition: transform var(--dur-mid) var(--ease-out); }
  .js .tabs__ind { display: block; }
  .tabs__tab { position: relative; z-index: 1; min-height: var(--tap); padding: var(--s-1) var(--s-2); border: 0; border-radius: calc(var(--radius) - var(--s-1)); background: var(--color-clear); color: var(--color-on-brand); font-size: 0.9375rem; font-weight: 700; line-height: 1.1; cursor: pointer; transition: color var(--dur-mid) var(--ease-out); }
  .tabs__tab[aria-selected="true"] { color: var(--color-brand-ink); background: var(--color-surface); }
  .js .tabs__tab[aria-selected="true"] { background: var(--color-clear); }
  @media (max-width: 479px) { .tab-more { display: none; } }
  .tabs__tab[aria-selected="false"]:hover { text-decoration: underline; text-underline-offset: .25em; }

  .picker__row { display: grid; gap: var(--s-3); align-items: end; }
  .panels { display: grid; gap: var(--s-5); min-width: 0; }
  .js .panels { display: block; }
  .panel { display: grid; gap: var(--s-2); min-width: 0; }
  .panel[hidden] { display: none; }
  .js .panel:not([hidden]) { animation: fade 180ms var(--ease-out); }
  @keyframes fade { from { opacity: 0; } }
  .panel__top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); }
  .panel__label { font-size: var(--fs-small); color: var(--color-on-brand-2); }
  .panel__hint { font-size: var(--fs-small); line-height: 1.3; color: var(--color-on-brand-2); min-height: 1.3em; }

  /* plate in the proportion of a Ukrainian number plate */
  .plate { display: flex; align-items: stretch; height: 64px; background: var(--color-surface); border: 2px solid var(--color-text); border-radius: var(--radius-plate); overflow: hidden; }
  .plate:focus-within { outline: var(--focus-w) solid var(--color-accent); outline-offset: 2px; }
  .plate__ua { display: grid; align-content: center; justify-items: center; gap: 4px; width: 44px; flex: none; background: var(--color-brand); color: var(--color-on-brand); font-size: 0.8125rem; font-weight: 700; line-height: 1; }
  .plate__flag { width: 18px; height: 12px; border-radius: 2px; background: var(--color-brand-ink); border-bottom: 6px solid var(--color-accent); box-shadow: 0 0 0 1px var(--color-on-brand); }
  .plate__input { flex: 1; min-width: 0; border: 0; background: var(--color-clear); color: var(--color-text); font-size: var(--fs-plate); letter-spacing: 0.04em; text-align: center; padding: 0 var(--s-3); }
  .plate__input::placeholder { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 400; letter-spacing: 0; color: var(--color-text-muted); }
  .plate__input:focus-visible { outline: none; }

  /* VIN: one real input over 17 cells; each filled cell gets its bar (effect 3) */
  .vin { --vin-fs: clamp(1rem, 0.6rem + 1.9vw, 1.75rem); --vin-gap: 0.22em; position: relative; height: 64px; background: var(--color-surface); border: var(--edge-w) solid var(--color-field-edge); border-radius: var(--radius); font-size: var(--vin-fs); font-family: var(--font-mono); font-weight: 500; }
  .vin:focus-within { outline: var(--focus-w) solid var(--color-accent); outline-offset: 2px; }
  .vin__cells, .vin__input { position: absolute; inset: 0; padding: 0 0 0 max(0px, calc((100% - 17ch - 17 * var(--vin-gap)) / 2)); }
  .vin__cells { display: flex; align-items: center; gap: var(--vin-gap); pointer-events: none; }
  .vin__cell { position: relative; flex: none; width: 1ch; height: 1.5em; }
  .vin__cell::after, .vin__cell::before { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--color-rule); }
  .vin__cell::before { z-index: 1; height: 3px; background: var(--color-brand); transform: scaleY(0); transform-origin: bottom; transition: transform var(--dur-fast) var(--ease-out); }
  .vin__cell.is-filled::before { transform: scaleY(1); }
  .vin__input { width: 100%; height: 100%; border: 0; background: var(--color-clear); color: var(--color-text); font: inherit; letter-spacing: var(--vin-gap); text-align: left; }
  .vin__input:focus-visible { outline: none; }
  .vin__count { font-size: var(--fs-small); color: var(--color-on-brand); }

  .selects { display: grid; gap: var(--s-3); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .field { display: grid; gap: var(--s-2); min-width: 0; }
  .select { height: 64px; width: 100%; padding: 0 var(--s-3); border: var(--edge-w) solid var(--color-field-edge); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font-size: 1rem; }
  .select:focus-visible { outline-color: var(--color-accent); }
  .select:disabled { color: var(--color-text-muted); background: var(--color-bg-2); cursor: not-allowed; }

  .picker__go { display: grid; }
  .picker__go :global(.picker__find) { width: 100%; min-height: 56px; font-size: 1.0625rem; }
  .picker__alt { display: grid; gap: var(--s-4); margin-top: var(--s-2); }
  .expert { justify-content: flex-start; min-height: 52px; white-space: normal; text-align: left; }
  .expert__text { display: flex; flex-wrap: wrap; column-gap: var(--s-3); row-gap: 0; align-items: baseline; }
  .expert__num { font-size: 1.0625rem; }
  .hero__facts { color: var(--color-on-brand-2); font-size: var(--fs-body); max-width: 34rem; }
  .hero__aside { display: none; }
  @media (max-width: 767px) {
    .picker__alt { margin-top: var(--s-6); }
    .picker__go :global(.future-link__note[aria-hidden="true"]) { top: calc(100% + var(--s-1)); max-width: calc(100vw - 2 * var(--space)); white-space: nowrap; }
  }

  @media (min-width: 768px) {
    .hero { padding-block: var(--s-7) var(--s-7); }
    .hero__in { gap: var(--s-6); }
    .picker__row { grid-template-columns: minmax(0, 34rem) auto; align-items: end; }
    .picker__go { padding-bottom: calc(var(--fs-small) * 1.3 + var(--s-2)); }
    .picker__go :global(.picker__find) { min-height: 64px; padding-inline: var(--s-6); }
    .picker__alt { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--s-6); }
  }
  @media (min-width: 1024px) {
    .hero { padding-block: var(--s-7); }
    .hero__in { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-6); }
    .hero__title { grid-column: 1 / -1; }
    .picker { grid-column: 1 / span 8; }
    .hero__facts { display: none; }
    .hero__aside { grid-column: 10 / span 3; align-self: end; display: grid; gap: var(--s-5); margin: 0; padding-left: var(--s-5); border-left: var(--rule-w) solid var(--color-on-brand-2); }
    .hero__fact { display: grid; gap: var(--s-1); }
    .hero__num { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h2); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-on-brand); }
    .hero__fact dd { color: var(--color-on-brand-2); font-size: var(--fs-body); }
    .picker__alt { grid-template-columns: auto; justify-items: start; }
    .tabs { max-width: 34rem; }
    .plate, .vin, .select { height: 96px; }
    .plate__ua { width: 56px; font-size: 1rem; }
    .plate__flag { width: 24px; height: 16px; border-bottom-width: 8px; }
    .plate__input { font-size: 2.25rem; }
    .picker__go { padding-bottom: calc(var(--fs-small) * 1.3 + var(--s-2) + 20px); }
    .picker__go :global(.picker__find) { min-height: 56px; font-size: 1.125rem; }
  }
</style>

<script>
  // Tabs (roving focus, arrows), plate mask, VIN cells and counter. Car state goes to car.ts listeners.
  import { setCar } from "../scripts/car";
  const picker = document.querySelector<HTMLElement>("[data-picker]");
  if (picker) {
    const tabs = Array.from(picker.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") || "")!);
    const tablist = picker.querySelector<HTMLElement>("[role=tablist]")!;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      tablist.style.setProperty("--i", String(i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k === "ArrowRight" || k === "ArrowLeft" || k === "Home" || k === "End") {
          e.preventDefault();
          const n = k === "Home" ? 0 : k === "End" ? tabs.length - 1 : (i + (k === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
          select(n, true);
        }
      });
    });
    select(0);

    // Plate: latin letters of Ukrainian plates (cyrillic look-alikes mapped), format AA 1234 BB
    const map: Record<string, string> = { А: "A", В: "B", С: "C", Е: "E", Н: "H", І: "I", К: "K", М: "M", О: "O", Р: "P", Т: "T", Х: "X" };
    const plate = picker.querySelector<HTMLInputElement>("[data-plate]");
    plate?.addEventListener("input", () => {
      const raw = plate.value.toUpperCase().split("").map((c) => map[c] || c).join("").replace(/[^A-Z0-9]/g, "").slice(0, 8);
      const m = /^([A-Z]{0,2})(\d{0,4})([A-Z]{0,2})$/.exec(raw);
      plate.value = m ? [m[1], m[2], m[3]].filter(Boolean).join(" ") : raw;
      setCar(/^[A-Z]{2}\d{4}[A-Z]{2}$/.test(raw) ? plate.value : "");
    });

    // VIN: 17 chars, no I, O, Q
    const vin = picker.querySelector<HTMLInputElement>("[data-vin]");
    const cells = Array.from(picker.querySelectorAll<HTMLElement>(".vin__cell"));
    const count = picker.querySelector<HTMLElement>("[data-vin-count]");
    vin?.addEventListener("input", () => {
      vin.value = vin.value.toUpperCase().replace(/[^A-HJ-NPR-Z0-9]/g, "").slice(0, 17);
      const n = vin.value.length;
      cells.forEach((c, i) => c.classList.toggle("is-filled", i < n));
      if (count) count.textContent = `${n} / 17`;
      setCar(n === 17 ? vin.value : "");
    });

    // Make: the list is real (24 makes); models are not in the data, so the model field stays closed
    const make = picker.querySelector<HTMLSelectElement>("[data-make]");
    make?.addEventListener("change", () => setCar(make.value));
  }
</script>
